# Copie para .env.local e preencha. .env.local nunca e versionado.
# Ordem de leitura (Next, Prisma CLI e Vitest usam a mesma):
#   .env.<modo>.local > .env.local > .env.<modo> > .env
# Em modo test o .env.local e IGNORADO: use .env.test.local.

# Conexao usada pela aplicacao em runtime.
#  - Local: `npm run db:local` imprime a URL (a porta varia por instancia), no formato
#    postgres://postgres:postgres@localhost:51218/drusign?sslmode=disable
#    (crie o banco `drusign` com TEMPLATE template0 e nao use o template1; para migrar
#     localmente use `npm run db:migrar -- <nome>`, porque o prisma dev nao tem shadow database)
#  - Neon (branch, host com -pooler):
#    postgresql://USER:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Conexao DIRETA usada so pelo Prisma CLI (migrate). Local: igual a DATABASE_URL. Neon: sem -pooler.
DIRECT_URL=

# Usado so pelo seed (npm run db:seed) para criar o primeiro administrador.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_SENHA=

# Usuario de operacao (producao), opcional; existe para o teste que prova que ele nao entra na administracao.
SEED_OPERACAO_LOGIN=producao
SEED_OPERACAO_SENHA=

# Opcional: teto do pool de conexoes do Prisma (pg). Deixe vazio na Neon (padrao do pg = 10).
# Local: o `prisma dev` (PGlite) aceita poucas conexoes simultaneas e o teto ENCOLHE a cada
# servidor morto a força (Playwright, taskkill); com 2 o `next dev` nunca passa do limite.
# Se mesmo assim aparecer "Connection terminated unexpectedly", reinicie o daemon:
#   npx prisma dev stop drusign && npm run db:local
DATABASE_POOL_MAX=
